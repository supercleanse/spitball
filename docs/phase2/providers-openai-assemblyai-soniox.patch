+"""Hand-rolled multipart/form-data encoding (stdlib only -- no `requests`,
+no third-party multipart helper). Used by the OpenAI-compatible transcription
+provider to upload an audio file plus form fields to `/audio/transcriptions`.
+"""
+from __future__ import annotations
+
+import binascii
+import os
+
+
+def encode(fields: dict, file_field: str, filename: str, data: bytes,
+           content_type: str = "application/octet-stream") -> tuple[str, bytes]:
+    """Builds a multipart/form-data body from a dict of plain string fields
+    plus one file part. Returns (content_type_header, body_bytes)."""
+    boundary = binascii.hexlify(os.urandom(16)).decode()
+    parts = []
+    for name, value in fields.items():
+        parts.append(
+            f"--{boundary}\r\n"
+            f'Content-Disposition: form-data; name="{name}"\r\n\r\n'
+            f"{value}\r\n".encode()
+        )
+    parts.append(
+        (f"--{boundary}\r\n"
+         f'Content-Disposition: form-data; name="{file_field}"; filename="{filename}"\r\n'
+         f"Content-Type: {content_type}\r\n\r\n").encode()
+        + data + b"\r\n"
+    )
+    parts.append(f"--{boundary}--\r\n".encode())
+    body = b"".join(parts)
+    return f"multipart/form-data; boundary={boundary}", body
diff --git a/spitball/providers/openai.py b/spitball/providers/openai.py
